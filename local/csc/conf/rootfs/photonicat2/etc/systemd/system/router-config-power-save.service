[Unit]
Description=Router Config auto WWAN/MBIM power save
Documentation=man:router-config(8)
After=network-online.target NetworkManager.service systemd-networkd.service mbim-session.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/router-config-power-save-run --interval 5 --standby-disconnect-profile true --standby-keep-radio-on false --standby-radio-off-delay 300 --ignore-prefix wwan --ignore-prefix wwu --ignore-prefix ppp --ignore-prefix cdc-wdm --ignore-prefix tun --ignore-prefix wg
StandardOutput=journal
StandardError=journal
