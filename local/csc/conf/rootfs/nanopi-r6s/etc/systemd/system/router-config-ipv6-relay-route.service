[Unit]
Description=router-config IPv6 relay route
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ip -6 route replace 240b:11:1381:5200::/64 dev br0 metric 10
ExecStop=/usr/sbin/ip -6 route del 240b:11:1381:5200::/64 dev br0 metric 10

[Install]
WantedBy=multi-user.target
